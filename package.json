{
  "name": "base-02",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "base-gh": "./scripts/base-gh.mjs"
  },
  "scripts": {
    "build": "next build",
    "cf:build": "DISABLE_EMBEDDED_STUDIO=1 opennextjs-cloudflare build",
    "cf:deploy": "wrangler deploy",
    "cf:preview": "DISABLE_EMBEDDED_STUDIO=1 opennextjs-cloudflare preview",
    "cf:upload": "DISABLE_EMBEDDED_STUDIO=1 opennextjs-cloudflare upload",
    "dev": "next dev",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "sanity": "sanity",
    "sanity:seed": "node --env-file=.env.local ./scripts/seed-sanity.mjs",
    "gh": "node ./scripts/base-gh.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "qa": "npm run lint && npm run build:webpack && PLAYWRIGHT_TEST_BASE_URL=http://127.0.0.1:3000 npm run test:e2e",
    "preview": "npm run cf:build && npm run cf:preview",
    "deploy": "npm run cf:build && npm run cf:deploy",
    "upload": "npm run cf:build && npm run cf:upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@sanity/image-url": "^2.1.1",
    "next": "16.2.6",
    "next-sanity": "^13.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "^5.27.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.94.0"
  }
}
